  "scripts": {
    "build": "webpack",
    "test": "npm run test:unit",
    "test:unit": "jest --no-cache ./src",
    "test:coverage": "jest --no-cache ./src --coverage",
    "test:storybook": "test-storybook",
    "test:ci:coverage": "npm run test:coverage -- --runInBand",
    "lint": "npm run lint:lockfile && npm run lint:eslint",
    "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts npm github.com --allowed-schemes \"https:\" --empty-hostname false",
    "lint:eslint": "eslint src --max-warnings 0",
    "lint:eslint-fix": "eslint --fix src",
    "i18n:externalize": "i18next-cli extract --config ./i18next.config.js",
    "dev:storybook:build": "NODE_OPTIONS=--max_old_space_size=2048 storybook build",
    "dev:storybook:install": "playwright install chromium",
    "dev:storybook:start": "STORYBOOK_DEV=true storybook dev -p 6006 --no-open",
    "watch": "NODE_ENV=development webpack --watch"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
